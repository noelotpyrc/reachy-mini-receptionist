{
  "schema_version": 1,
  "pipelines": [
    {
      "id": "door_yolo_world",
      "detector": "yolo-world",
      "model": "yolov8s-worldv2.pt",
      "targets": [
        "door",
        "doorway",
        "entrance door"
      ],
      "threshold": 0.1,
      "text_threshold": 0.15,
      "inference_fps": 1.0,
      "tracker": "bytetrack",
      "role": "diagnosis",
      "device": "mps"
    },
    {
      "id": "door_grounding_dino",
      "detector": "grounding-dino",
      "model": "IDEA-Research/grounding-dino-tiny",
      "targets": [
        "door",
        "doorway",
        "entrance door"
      ],
      "threshold": 0.3,
      "text_threshold": 0.15,
      "inference_fps": 1.0,
      "tracker": "bytetrack",
      "role": "diagnosis",
      "device": "mps"
    }
  ]
}
