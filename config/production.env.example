# Non-secret production runtime configuration. The installer copies this to
# ~/.config/reachy-reception/production.env and never commits that private file.

# Fixed assisted shift. Override for a specific run only when the duration is deliberate.
LIVE_DURATION=28800
TZ=America/New_York

# Production artifact policy: retain audio and derived vision diagnostics, but no raw MKV video.
RECORD_AUDIO=1
RECORD_VIDEO=0
CAPTURE_VISION=1
RECORDING_RETENTION_DAYS=30
ARTIFACT_DISK_MIN_FREE_GB=20

# Accepted visitor and vision runtime configuration.
RECEPTION_VISITOR_TRIGGER_PROFILE=door-v4-20260827
RECEPTION_VISION_RUNTIME=broker-v1
RECEPTION_BROKER_CAPTURE_FPS=15
RECEPTION_BROKER_RECORDER_QUEUE_SIZE=30
RECEPTION_BROKER_GESTURE_QUEUE_SIZE=30
RECEPTION_BROKER_POLICY_IDLE_S=0.1
RECEPTION_GESTURE_RUNNING_MODE=image
RECEPTION_WAVE_DETECTION_MODE=open_palm
RECEPTION_RERUN_MODE=off

# Read-only aggregate health. The API key remains in the deploy-owned .env.
OPS_EXTENDED_HEALTH=1
OPS_REQUIRE_MANAGED_SERVICES=1
HERMES_HEALTH_URL=http://127.0.0.1:8642/health
PROVIDER_HEALTH_URL=https://openrouter.ai/api/v1/key
PROVIDER_HEALTH_API_KEY_ENV=OPENROUTER_API_KEY
EXTERNAL_HEALTH_TIMEOUT_S=5

# Managed non-physical services. The physical runner is intentionally not a service.
S2S_SERVICE_LABEL=com.reachy.reception.s2s
HERMES_SERVICE_LABEL=com.reachy.reception.hermes
HERMES_PROFILE=reachyclinic
HERMES_PORT=8642
S2S_PORT=8765
